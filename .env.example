# Copy to .env and provide your credentials. Never commit .env.
OPENAI_API_KEY=
# Select a model available to your account that supports structured output.
REVIEW_MODEL=

# GitHub access: set a token, or use an existing gh auth login.
# Anonymous public reads have lower API limits. GH_TOKEN is also supported.
GITHUB_TOKEN=
# Optional LangSmith tracing (source code may appear in traces).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=code-review-agent
